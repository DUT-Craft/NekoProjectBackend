# Copy this file to .env on the production server and replace every example.
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Required on the first production startup. After the admin is created, these
# values can be removed from the service environment.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=站点管理员

# Use a cryptographically random value with at least 32 characters.
JWT_SECRET=
JWT_TTL_SECONDS=259200
AUTH_COOKIE_SECURE=true

# Public HTTPS origin. When frontend and backend share one domain, use that
# same origin for both values. Never use * in CORS_ALLOWED_ORIGINS.
CORS_ALLOWED_ORIGINS=
PUBLIC_BASE_URL=

DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/neko_main_site
DATABASE_USERNAME=neko
DATABASE_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

FILE_STORAGE_PATH=/var/lib/neko-main-site/storage
# Keep these values aligned with the 8 MB image limit and the reverse proxy.
MAX_UPLOAD_FILE_SIZE=8MB
MAX_UPLOAD_REQUEST_SIZE=10MB
SERVER_STATUS_ENABLED=true
SERVER_STATUS_INTERVAL_MS=60000
SERVER_STATUS_CONNECT_TIMEOUT_MS=3000

# Optional Blessing Skin OAuth2 player login.
BLESSING_SKIN_ENABLED=false
BLESSING_SKIN_AUTHORIZATION_URL=
BLESSING_SKIN_TOKEN_URL=
BLESSING_SKIN_USER_INFO_URL=
BLESSING_SKIN_CLIENT_ID=
BLESSING_SKIN_CLIENT_SECRET=
BLESSING_SKIN_REDIRECT_URI=
BLESSING_SKIN_SCOPE=user
BLESSING_SKIN_CONNECT_TIMEOUT_MS=3000
BLESSING_SKIN_READ_TIMEOUT_MS=5000
