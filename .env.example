# Local development defaults to the local Spring profile.
# Set SPRING_PROFILES_ACTIVE=prod only when PostgreSQL and Redis are ready.
# For a real server deployment, start from .env.production.example instead.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Local admin account. Change these values before sharing a running instance.
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin12345
LOCAL_ADMIN_EMAIL=admin@neko.local

# Authentication
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL_SECONDS=259200
AUTH_COOKIE_SECURE=false
ARGON2_SALT_LENGTH=16
ARGON2_HASH_LENGTH=32
ARGON2_PARALLELISM=1
ARGON2_MEMORY=16384
ARGON2_ITERATIONS=2

# Browser frontend origins for this project (Nuxt uses port 3000 locally).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Blessing Skin OAuth2 player login
BLESSING_SKIN_ENABLED=false
BLESSING_SKIN_AUTHORIZATION_URL=
BLESSING_SKIN_TOKEN_URL=
BLESSING_SKIN_USER_INFO_URL=
BLESSING_SKIN_CLIENT_ID=
BLESSING_SKIN_CLIENT_SECRET=
BLESSING_SKIN_REDIRECT_URI=http://127.0.0.1:8080/api/auth/blessing/callback
BLESSING_SKIN_SCOPE=user
BLESSING_SKIN_CONNECT_TIMEOUT_MS=3000
BLESSING_SKIN_READ_TIMEOUT_MS=5000

# File and status services
FILE_STORAGE_PATH=./storage
# Leave empty when the browser reaches the backend through Nuxt's same-origin
# /api proxy. Set a full public origin only for a directly exposed backend.
PUBLIC_BASE_URL=
SERVER_STATUS_ENABLED=false
SERVER_STATUS_INTERVAL_MS=60000
SERVER_STATUS_CONNECT_TIMEOUT_MS=3000

# Production database and Redis
DATABASE_URL=jdbc:postgresql://localhost:5432/neko_main_site
DATABASE_USERNAME=neko
DATABASE_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
